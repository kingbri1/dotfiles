layout {
    // Circumvents the default_tab_template + hide_floating_panes bug
    new_tab_template {
        pane

        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="editor" focus=true hide_floating_panes=true {
        pane split_direction="vertical" {
            pane command="zsh" size="75%" focus=true borderless=true {
                args "-ic" "nvim; exec zsh"
            }

            pane command="zsh" size="25%" borderless=true {
                args "-ic" "opencode; exec zsh"
            }
        }

        floating_panes {
            pane {
                x "15%"
                y "15%"
                width "70%"
                height "70%"
            }
        }

        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}
